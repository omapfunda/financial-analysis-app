# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-secret-key-here
HOST=0.0.0.0
PORT=5000

# Cache Settings
CACHE_TIMEOUT=900
CACHE_DIR=cache

# Portfolio Settings
MAX_PORTFOLIO_SIZE=50
MIN_PORTFOLIO_SIZE=1

# API Settings
API_TIMEOUT=30
MAX_RETRIES=3

# Analysis Settings
DEFAULT_RISK_FREE_RATE=0.02
DEFAULT_MARKET_RETURN=0.10

# Valuation Thresholds
STRONG_BUY_THRESHOLD=0.7
BUY_THRESHOLD=0.9
HOLD_THRESHOLD=1.1

# Logging
LOG_LEVEL=WARNING
LOG_FILE=app.log